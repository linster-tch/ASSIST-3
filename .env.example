# ==============================================================================
# ASSIST APP ENVIRONMENT CONFIGURATION
# ==============================================================================
# The Assist app is designed to run in fallback / local mode out of the box,
# and will gracefully degrade with helpful UI notices if keys are not provided.
# Populate the keys below to enable full external cloud integrations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Used for storing users, emergency contacts, crowdsourced accessible places,
# obstacle reports, route history, caretaker profiles, and bookings.
# Fallback: When DATABASE_URL is not configured, the app uses in-memory / local storage persistence.
DATABASE_URL="postgresql://assist_user:password@localhost:5432/assist_db?schema=public"

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS PLATFORM (Maps SDK, Directions API, Places API)
# ------------------------------------------------------------------------------
# Required for live Google Maps rendering, Google Places search, and base Directions.
# Fallback: An interactive OpenStreetMap / vector canvas map with seeded Indian cities
# (Delhi, Mumbai, Bengaluru) is rendered when this key is omitted.
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# 4. TWILIO (SMS & Emergency SOS Dispatch)
# ------------------------------------------------------------------------------
# Required for automated server-side SMS dispatch of GPS coordinates to emergency contacts.
# Fallback: When missing, the app triggers device-native SMS URI (sms:+91...?body=...)
# and provides direct 1-tap WhatsApp sharing and the native 112 dialer.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 5. FIREBASE (Auth, Cloud Storage for Obstacle Photos & Caretaker IDs, Cloud Messaging)
# ------------------------------------------------------------------------------
# Used for user authentication, cloud storage of obstacle photos and caretaker verification documents.
# Fallback: Local client-side session and base64 storage are used when not configured.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 6. GOOGLE CLOUD ML & GEMINI AI (Fallback Vision & Multimodal Obstacle Parsing)
# ------------------------------------------------------------------------------
# Used for server-side visual obstacle classification fallback and voice translation.
GEMINI_API_KEY=""
GOOGLE_CLOUD_VISION_API_KEY=""
GOOGLE_CLOUD_SPEECH_API_KEY=""
